# ── Docker ignore ─────────────────────────────────────────────────────────────
# Git
.git
.gitignore
.gitattributes

# Docker / Kubernetes files (not needed inside the image)
Dockerfile
docker-compose.yml
k8s/

# Dev / test files
test.php
*.sh
*.md

# Database files (never bake credentials into the image)
*.sql
*.db

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
